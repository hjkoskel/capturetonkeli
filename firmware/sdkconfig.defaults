# Baseline for capturetonkeli firmware (docs/10 §4). Validate with the API smoke build in M0.
CONFIG_IDF_TARGET="esp32c5"

# Console/logging off: USB Serial/JTAG carries only CTP frames
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y

# Zero flash writes at runtime
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n

# Unused radios/stacks
CONFIG_BT_ENABLED=n
CONFIG_IEEE802154_ENABLED=n

# Robustness
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_BROWNOUT_DET=y

# Build
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_APP_BUILD_MINIMIZE_BINARY_CHANGES=n

# PSRAM not needed
CONFIG_SPIRAM=n

# 1 kHz tick: link task polls USB with 1 ms timeouts (docs/07 §3)
CONFIG_FREERTOS_HZ=1000
